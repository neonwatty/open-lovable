# LOCAL DEVELOPMENT CONFIGURATION

# Enable local mode optimizations for development (optional)
LOCAL_MODE=true

# Sandbox root directory - all sandboxes will be created here (optional)
LOCAL_SANDBOX_ROOT=./sandboxes

# Legacy single sandbox path (deprecated, use LOCAL_SANDBOX_ROOT instead)
LOCAL_SANDBOX_PATH=./sandbox

# PORT MANAGEMENT CONFIGURATION
# Default Vite development server port (optional)
VITE_PORT=5173

# Port range for dynamic allocation (optional)
SANDBOX_PORT_START=5173
SANDBOX_PORT_END=5200

# Port allocation configuration (optional)
SANDBOX_PORT_MAX_RETRIES=10
SANDBOX_PORT_CHECK_TIMEOUT=2000
SANDBOX_BIND_ADDRESS=localhost

# Force specific port (overrides dynamic allocation, optional)
# FORCE_SANDBOX_PORT=5173

# Port conflict resolution: increment, random, or fail (optional)
SANDBOX_PORT_CONFLICT_STRATEGY=increment

# SANDBOX DIRECTORY MANAGEMENT
# Automatically clean up sandboxes older than this many hours (optional)
SANDBOX_CLEANUP_HOURS=24

# Maximum concurrent sandboxes (optional)
SANDBOX_MAX_CONCURRENT=10

# Sandbox naming strategy: uuid, timestamp, or sequential (optional)
SANDBOX_NAMING_STRATEGY=uuid

# Enable sandbox isolation with separate node_modules (optional)
SANDBOX_ISOLATION=false

# Sandbox template directory for initialization (optional)
# SANDBOX_TEMPLATE_PATH=./templates/default-sandbox

# Enable sandbox metadata tracking (optional)
SANDBOX_METADATA=true

# Enable disk space monitoring (optional)
SANDBOX_DISK_MONITORING=true

# Maximum disk space per sandbox in MB (optional)
SANDBOX_MAX_SIZE_MB=500

# Development environment flag
NODE_ENV=development

# PERFORMANCE OPTIMIZATION SETTINGS (LOCAL MODE)
# Enable these for enhanced local development performance

# Fast build and hot reload optimizations (optional)
FAST_REFRESH=true

# Inline source maps for debugging (optional, increases bundle size)
INLINE_SOURCE_MAPS=false

# Enable verbose logging for debugging (optional)
DEBUG_LOGGING=false

# Performance monitoring in development (optional)
ENABLE_PERFORMANCE_MONITORING=false

# TESTING CONFIGURATION FOR LOCAL DEVELOPMENT
# Jest test optimization settings (optional)

# Coverage collection (set to true for test coverage reports)
COVERAGE=false

# Verbose test output (for debugging test failures)
JEST_VERBOSE=false

# Silent test mode (reduce console noise during tests)
JEST_SILENT=false

# Force sequential test execution (for debugging race conditions)
FORCE_SEQUENTIAL=false

# SECURITY SETTINGS (LOCAL DEVELOPMENT)
# These are for local development security (optional)

# Enable CORS for local API requests (usually true for development)
ENABLE_CORS=true

# Maximum request size for file uploads
MAX_REQUEST_SIZE=10mb

# LOCAL DEVELOPMENT UTILITIES
# Utility settings for local development workflow (optional)

# Auto-open browser on dev server start
AUTO_OPEN_BROWSER=false

# Enable hot module replacement
HMR_ENABLED=true

# Custom host for development server (use 0.0.0.0 for network access)
DEV_HOST=localhost

# DEPENDENCY MANAGEMENT
# Settings for package installation and management (optional)

# Use local npm registry (for offline development)
USE_LOCAL_REGISTRY=false

# Local npm registry URL (if USE_LOCAL_REGISTRY is true)
# LOCAL_REGISTRY_URL=http://localhost:4873

# Package installation strategy: npm, yarn, or pnpm
PACKAGE_INSTALL_STRATEGY=npm