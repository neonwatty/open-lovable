{
  "name": "open-lovable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:integration": "node tests/e2b-integration.test.js",
    "test:api": "node tests/api-endpoints.test.js",
    "test:code": "node tests/code-execution.test.js",
    "test:sandbox-manager": "npx tsx tests/sandbox-manager-simple.test.js",
    "test:sandbox-manager-vitest": "npx vitest lib/sandbox/__tests__/sandboxManager.integration.test.ts --run",
    "test:vite-process-manager": "npx tsx tests/vite-process-manager-tsx.test.ts",
    "test:vite-process-manager-vitest": "npx vitest lib/sandbox/__tests__/viteProcessManager.simple.test.ts --run",
    "test:api-create-sandbox": "npx tsx tests/api-create-sandbox.test.js",
    "test:api-create-sandbox-vitest": "npx vitest lib/api/__tests__/create-ai-sandbox.test.ts --run",
    "test:task-1-integration": "npx tsx tests/task-1-integration.test.js",
    "test:e2b-replacement": "npx tsx tests/e2b-replacement-verification.test.js",
    "test:task-1-full": "npm run test:task-1-integration && npm run test:e2b-replacement",
    "test:task-2": "npm run test:apply-ai-code-stream && npm run test:file-watcher && npm run test:path-migration && npm run test:integration-file-ops && npm run test:task-2-audit",
    "test:task-2-audit": "npx vitest tests/task-2-coverage-audit.test.ts --run",
    "test:apply-ai-code-stream": "npx vitest tests/apply-ai-code-stream.test.ts --run",
    "test:file-watcher": "npx vitest tests/file-watcher.test.ts --run",
    "test:path-migration": "npx vitest tests/path-migration.test.ts --run",
    "test:integration-file-ops": "npx vitest tests/integration-file-operations.test.ts --run",
    "test:performance": "npx vitest tests/performance-benchmarks.test.ts --run",
    "test:all": "npm run test:sandbox-manager && npm run test:vite-process-manager && npm run test:vite-process-manager-vitest && npm run test:api-create-sandbox && npm run test:api-create-sandbox-vitest && npm run test:task-1-integration && npm run test:e2b-replacement && npm run test:task-2"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.4.21",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.532.0",
    "next": "15.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.5.0",
    "react-syntax-highlighter": "^15.6.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9",
    "eslint-config-next": "15.4.3",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
